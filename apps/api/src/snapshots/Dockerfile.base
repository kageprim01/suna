# syntax=docker/dockerfile:1.7
# Kortix sandbox base image — pre-bakes ALL runtime infrastructure so the
# per-deploy template Dockerfile (when using e2bBaseImage) has zero
# COPY-heavy instructions. E2B's envd auto-update (~T+5s into any build)
# corrupts COPY archive extraction; by baking everything into a base image,
# the per-deploy Dockerfile becomes a thin FROM + opencode warm-up layer
# that completes in < 1s, safely before the timer.
#
# Build and push after bumping any pinned version below:
#   docker buildx build \
#     --build-arg OPENCODE_VERSION=<version> \
#     --build-arg AGENT_BROWSER_VERSION=<version> \
#     -t ghcr.io/kortix/sandbox-base:latest \
#     --push \
#     -f apps/api/src/snapshots/Dockerfile.base \
#     .

FROM ubuntu:24.04

WORKDIR /workspace

USER root

# ── System deps ──────────────────────────────────────────────────
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git gzip nodejs npm unzip tmux iproute2 iputils-arping \
    && rm -rf /var/lib/apt/lists/*

# ── opencode CLI ─────────────────────────────────────────────────
ARG OPENCODE_VERSION
RUN npm install -g --no-audit --no-fund "opencode-ai@${OPENCODE_VERSION}" \
    && command -v opencode \
    && opencode --version

# Bake OpenCode's "one time database migration" at BUILD time.
ENV HOME=/opt/kortix/home \
    XDG_DATA_HOME=/opt/kortix/home/.local/share \
    XDG_CONFIG_HOME=/opt/kortix/home/.config \
    XDG_CACHE_HOME=/opt/kortix/home/.cache
RUN mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" \
    && opencode serve --port 4096 --hostname 127.0.0.1 >/tmp/oc-bake.log 2>&1 & oc_pid=$! \
    && for i in $(seq 1 180); do \
        curl -s -o /dev/null -m 2 http://127.0.0.1:4096/ && break; \
        kill -0 "$oc_pid" 2>/dev/null || break; \
        sleep 1; \
    done; \
    sleep 3; \
    kill "$oc_pid" 2>/dev/null; wait "$oc_pid" 2>/dev/null; \
    rm -f /tmp/oc-bake.log; true

# ── bun runtime ──────────────────────────────────────────────────
RUN npm install -g --no-audit --no-fund bun \
    && bun --version

# Pre-install OpenCode tool deps once so boot install is a no-op.
RUN mkdir -p /opt/kortix/home/.bun/install/cache /opt/kortix/opencode-config-deps \
    && cd /opt/kortix/opencode-config-deps \
    && printf '{"name":"kortix-opencode-config","private":true,"dependencies":{"@mendable/firecrawl-js":"^4.25.1","@tavily/core":"^0.7.3","replicate":"^1.4.0"}}' > package.json \
    && HOME=/opt/kortix/home BUN_INSTALL_CACHE_DIR=/opt/kortix/home/.bun/install/cache bun install

# ── agent-browser + Playwright Chromium ─────────────────────────
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    AGENT_BROWSER_EXECUTABLE_PATH=/usr/local/bin/chromium \
    AGENT_BROWSER_ARGS=--no-sandbox,--disable-dev-shm-usage
ARG AGENT_BROWSER_VERSION=0.27.0
ARG PLAYWRIGHT_VERSION=1.60.0
RUN npm install -g --no-audit --no-fund "agent-browser@${AGENT_BROWSER_VERSION}" \
    && agent-browser --version \
    && HOME=/opt/kortix/home npx -y "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && pw_chrome="$(find /opt/pw-browsers -type f -path '*chrome-linux*/chrome' | head -n1)" \
    && test -n "$pw_chrome" \
    && ln -sf "$pw_chrome" /usr/local/bin/chromium \
    && mkdir -p /opt/kortix/home/.agent-browser/browsers \
    && ln -sf "$(dirname "$pw_chrome")" /opt/kortix/home/.agent-browser/browsers/chrome-linux64 \
    && /usr/local/bin/chromium --version \
    && env -u AGENT_BROWSER_EXECUTABLE_PATH HOME=/opt/kortix/home agent-browser doctor 2>&1 | grep -qE 'pass.+chrome-linux64/chrome'

# ── Kortix agent binary ─────────────────────────────────────────
# Built from apps/kortix-sandbox-agent-server during base image creation.
# The per-deploy Dockerfile (when using e2bBaseImage) skips COPY for this
# since it's pre-baked here.
COPY apps/kortix-sandbox-agent-server /tmp/kortix-agent-src
RUN cd /tmp/kortix-agent-src \
    && BUN_COMPILE_TARGET=bun-linux-x64 bun run build \
    && cp dist/kortix-agent /usr/local/bin/kortix-agent \
    && chmod +x /usr/local/bin/kortix-agent \
    && kortix-agent --version \
    && rm -rf /tmp/kortix-agent-src

# ── Kortix CLI binary ───────────────────────────────────────────
# Built from apps/cli during base image creation.
COPY apps/cli /tmp/kortix-cli-src
RUN cd /tmp/kortix-cli-src \
    && BUN_COMPILE_TARGET=bun-linux-x64 bun run build \
    && cp dist/kortix /usr/local/bin/kortix \
    && chmod +x /usr/local/bin/kortix \
    && kortix --version \
    && rm -rf /tmp/kortix-cli-src

# ── slack-cli ────────────────────────────────────────────────────
# Copied from apps/sandbox/slack-cli into the base image so the per-deploy
# Dockerfile (e2bBaseImage) doesn't need to COPY it (large directory).
COPY apps/sandbox/slack-cli /opt/kortix/apps/sandbox/slack-cli
RUN find /opt/kortix/apps/sandbox/slack-cli -name 'node_modules' -exec rm -rf {} + 2>/dev/null; true

# ── executor-sdk ────────────────────────────────────────────────
# Pre-staged so the per-deploy Dockerfile (e2bBaseImage) skips this COPY.
COPY packages/executor-sdk /opt/kortix/packages/executor-sdk

# ── scaffold.git (bare repo) ────────────────────────────────────
# Pre-staged so the per-deploy Dockerfile (e2bBaseImage) skips this COPY.
COPY scaffold.git /opt/kortix/scaffold.git

# ── LLM catalog ─────────────────────────────────────────────────
# Optional — only included if the build context has it.
COPY kortix-llm-catalog.json /opt/kortix/llm-catalog.json 2>/dev/null; true

# ── opencode starter config ─────────────────────────────────────
# Pre-staged so the per-deploy Dockerfile (e2bBaseImage) skips COPY.
COPY .kortix/opencode /opt/kortix/warm-config/.kortix/opencode

CMD ["sleep", "infinity"]